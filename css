/* GOVERNMENT SCHEMES SECTION */

.government-section {
  padding: 70px 7%;
  background: linear-gradient(180deg, #f5f8ef, #edf5e9);
  font-family: inherit;
}

/* Section heading */

.gov-header {
  text-align: center;
  max-width: 750px;
  margin: 0 auto 45px;
}

.gov-badge {
  display: inline-block;
  padding: 9px 17px;
  border-radius: 30px;
  background: #dcebd8;
  color: #205c38;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
}

.gov-header h2 {
  color: #174d32;
  font-size: clamp(27px, 4vw, 40px);
  margin: 20px 0 15px;
  line-height: 1.25;
}

.gov-header p {
  color: #617264;
  font-size: 16px;
  line-height: 1.8;
}

/* Responsive card grid */

.gov-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 25px;
  max-width: 1200px;
  margin: auto;
}

/* Individual cards */

.gov-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #ffffff;
  padding: 28px;
  border-radius: 20px;
  border: 1px solid #e1ebdc;
  box-shadow: 0 8px 25px rgba(32, 92, 56, 0.07);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.gov-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, #236b42, #a5cf77);
}

.gov-card:hover {
  transform: translateY(-7px);
  box-shadow: 0 16px 35px rgba(32, 92, 56, 0.14);
}

/* Icons */

.gov-icon {
  width: 65px;
  height: 65px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: #edf6e8;
  font-size: 32px;
  margin-bottom: 20px;
}

/* Category label */

.gov-tag {
  display: inline-block;
  padding: 7px 11px;
  border-radius: 20px;
  background: #f0f5e9;
  color: #397047;
  font-size: 11px;
  font-weight: 800;
  margin-bottom: 12px;
}

/* Card content */

.gov-card h3 {
  color: #204d32;
  font-size: 21px;
  line-height: 1.4;
  margin: 0 0 12px;
}

.gov-card p {
  color: #657267;
  font-size: 14px;
  line-height: 1.8;
  margin: 0 0 24px;
}

/* Button */

.gov-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: auto;
  padding: 12px 17px;
  border-radius: 10px;
  background: #205c38;
  color: #ffffff;
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
  transition: background 0.25s ease;
}

.gov-button:hover {
  background: #123e26;
}

.gov-button:focus-visible {
  outline: 3px solid #a5cf77;
  outline-offset: 4px;
}

/* Bottom information panel */

.gov-footer {
  display: flex;
  align-items: center;
  gap: 20px;
  max-width: 900px;
  margin: 50px auto 20px;
  padding: 25px 30px;
  background: #205c38;
  color: white;
  border-radius: 18px;
}

.gov-footer > span {
  font-size: 42px;
}

.gov-footer h3 {
  margin: 0 0 8px;
  font-size: 21px;
}

.gov-footer p {
  margin: 0;
  color: #e3f0e3;
  font-size: 14px;
  line-height: 1.8;
}

.gov-disclaimer {
  max-width: 900px;
  margin: 25px auto 0;
  text-align: center;
  color: #6c796d;
  font-size: 12px;
  line-height: 1.8;
}

/* Tablet */

@media (max-width: 950px) {
  .gov-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Mobile */

@media (max-width: 600px) {
  .government-section {
    padding: 45px 18px;
  }

  .gov-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .gov-card {
    padding: 24px;
  }

  .gov-footer {
    align-items: flex-start;
    padding: 22px;
  }

  .gov-footer > span {
    font-size: 32px;
  }
}
/* ========================================
   🌾 SMART AGROVISION
   Soft Nature + Pastel Colour Theme
======================================== */

:root {
  --primary: #739B78;
  --primary-dark: #285943;
  --primary-light: #E4F2E5;

  --background: #F8F7EF;
  --white: #FFFFFF;

  --mint: #E4F2E5;
  --yellow: #FFF1C7;
  --peach: #FFE4D6;
  --lavender: #EDE7F6;
  --blue: #E1F1FA;
  --pink: #FBE5EC;

  --text: #34463A;
  --text-light: #6F7F72;

  --border: #E3EADF;
  --shadow: 0 8px 24px rgba(49, 91, 63, 0.09);
  --radius: 18px;
}

/* Main website */

html {
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--text);
  font-family: "Poppins", "Segoe UI", sans-serif;
  line-height: 1.7;
  margin: 0;
}

/* Headings */

h1, h2, h3, h4 {
  color: var(--primary-dark);
  font-weight: 700;
  line-height: 1.35;
}

h1 {
  letter-spacing: -0.5px;
}

h2 {
  margin-bottom: 20px;
}

p {
  color: var(--text-light);
}

/* Navigation bar */

nav,
.navbar,
header {
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 4px 18px rgba(49, 91, 63, 0.06);
}

nav a,
.navbar a {
  color: var(--primary-dark);
  font-weight: 600;
  text-decoration: none;
  transition: color 0.25s ease;
}

nav a:hover,
.navbar a:hover {
  color: var(--primary);
}

/* Hero section */

.hero {
  background: linear-gradient(
    135deg,
    #E4F2E5 0%,
    #F8F7EF 50%,
    #FFF1C7 100%
  );
  border-radius: 0 0 35px 35px;
  padding: 65px 24px;
}

/* Main sections */

section {
  padding-top: 30px;
  padding-bottom: 30px;
}

/* Cards */

.card,
.scheme-card,
.feature-card,
.market-card,
.service-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 22px;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.card:hover,
.scheme-card:hover,
.feature-card:hover,
.market-card:hover,
.service-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 14px 30px rgba(49, 91, 63, 0.14);
}

/* Pastel card variations */

.card:nth-child(5n + 1) {
  border-top: 4px solid #8DBB91;
}

.card:nth-child(5n + 2) {
  border-top: 4px solid #F1CC79;
}

.card:nth-child(5n + 3) {
  border-top: 4px solid #E9AD91;
}

.card:nth-child(5n + 4) {
  border-top: 4px solid #B9A8DE;
}

.card:nth-child(5n + 5) {
  border-top: 4px solid #8CC6E5;
}

/* Government scheme cards */

.scheme-card {
  background: linear-gradient(145deg, #FFFFFF, #F0F8EF);
  border-left: 5px solid #739B78;
}

.scheme-card h3 {
  color: #285943;
}

.scheme-card .icon {
  background: var(--mint);
  border-radius: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  font-size: 26px;
}

/* Buttons */

button,
.btn,
.button,
input[type="submit"] {
  background: #347653;
  border: none;
  border-radius: 12px;
  color: #FFFFFF;
  cursor: pointer;
  font: inherit;
  font-weight: 600;
  padding: 12px 22px;
  transition:
    background 0.25s ease,
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

button:hover,
.btn:hover,
.button:hover,
input[type="submit"]:hover {
  background: #285943;
  box-shadow: 0 6px 15px rgba(40, 89, 67, 0.18);
  transform: translateY(-2px);
}

/* Secondary buttons */

.btn-secondary {
  background: #E4F2E5;
  color: #285943;
}

.btn-secondary:hover {
  background: #D2E8D4;
  color: #285943;
}

/* Form fields */

input,
select,
textarea {
  background: #FFFFFF;
  border: 1px solid #D8E4D8;
  border-radius: 10px;
  color: var(--text);
  font: inherit;
  max-width: 100%;
  padding: 12px 14px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #739B78;
  box-shadow: 0 0 0 3px rgba(115, 155, 120, 0.15);
  outline: none;
}

/* Weather and information panels */

.weather-card {
  background: linear-gradient(135deg, #E1F1FA, #FFFFFF);
}

.info-card {
  background: linear-gradient(135deg, #EDE7F6, #FFFFFF);
}

.success-card {
  background: linear-gradient(135deg, #E4F2E5, #FFFFFF);
}

.warning-card {
  background: linear-gradient(135deg, #FFF1C7, #FFFFFF);
}

/* Tables */

table {
  background: #FFFFFF;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 14px;
  overflow: hidden;
  width: 100%;
}

th {
  background: #DCEBDD;
  color: #285943;
  font-weight: 700;
  padding: 14px;
  text-align: left;
}

td {
  border-bottom: 1px solid #E8EEE5;
  padding: 13px 14px;
}

tr:hover td {
  background: #F3F8F0;
}

/* Status labels */

.badge,
.tag {
  background: #E4F2E5;
  border-radius: 20px;
  color: #285943;
  display: inline-block;
  font-size: 13px;
  font-weight: 600;
  padding: 5px 12px;
}

/* Links */

a {
  color: #347653;
}

a:hover {
  color: #285943;
}

/* Footer */

footer {
  background: #285943;
  border-radius: 25px 25px 0 0;
  color: #FFFFFF;
  margin-top: 40px;
  padding: 35px 20px;
}

footer p,
footer h2,
footer h3,
footer a {
  color: #FFFFFF;
}

/* Scrollbar */

::-webkit-scrollbar {
  width: 9px;
}

::-webkit-scrollbar-track {
  background: #F8F7EF;
}

::-webkit-scrollbar-thumb {
  background: #A5C5A5;
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: #739B78;
}

/* Mobile responsiveness */

@media (max-width: 768px) {
  .hero {
    border-radius: 0 0 24px 24px;
    padding: 40px 18px;
  }

  section {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .card,
  .scheme-card,
  .feature-card,
  .market-card,
  .service-card {
    border-radius: 15px;
    padding: 17px;
  }

  button,
  .btn,
  .button {
    max-width: 100%;
  }
}

/* Respect reduced-motion preferences */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}
